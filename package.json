{
  "author": "Nicholas Jamieson <nicholas@cartant.com>",
  "bugs": {
    "url": "https://github.com/cartant/eslint-plugin-rxjs/issues"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.46.4",
    "common-tags": "^1.8.0",
    "decamelize": "^5.0.0",
    "requireindex": "~1.2.0",
    "rxjs-report-usage": "^1.0.4",
    "tslib": "^2.8.1",
    "tsutils": "^3.21.0"
  },
  "description": "ESLint rules for RxJS",
  "devDependencies": {
    "@types/chai": "^4.2.0",
    "@types/common-tags": "^1.8.0",
    "@types/eslint": "^9.6.1",
    "@types/mocha": "^9.0.0",
    "@types/node": "^22.19.0",
    "@typescript-eslint/rule-tester": "^8.46.4",
    "chai": "^4.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "mocha": "^9.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "rxjs": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "files": [
    "dist",
    "docs"
  ],
  "homepage": "https://github.com/cartant/eslint-plugin-rxjs",
  "keywords": [
    "lint",
    "rules",
    "eslint",
    "rxjs"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts}": "prettier --write"
  },
  "main": "./dist/index.js",
  "name": "eslint-plugin-rxjs",
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  },
  "private": false,
  "publishConfig": {
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cartant/eslint-plugin-rxjs.git"
  },
  "scripts": {
    "dist": "npm run lint && npm run dist:build",
    "dist:build": "npm run dist:clean && tsc -p tsconfig-dist.json",
    "dist:clean": "rimraf dist",
    "lint": "eslint source/**/*.ts tests/**/*.ts",
    "prepare": "husky install",
    "prepack": "npm run test && npm run dist",
    "prettier": "prettier --write \"./{src,tests}/**/*.{js,json,ts,tsx}\"",
    "prettier:ci": "prettier --check \"./{src,tests}/**/*.{js,json,ts,tsx}\"",
    "test": "npm run test:rules && npm run test:specs",
    "test:debug": "mocha -r ts-node/register -t 5000 tests/rules/no-redundant-notify.ts",
    "test:rules": "mocha -r ts-node/register -t 5000 tests/rules/*.ts",
    "test:rule": "mocha -r ts-node/register -t 5000",
    "test:specs": "mocha -r ts-node/register tests/*-spec.ts"
  },
  "version": "5.0.3"
}
